---
import Layout from "../layouts/Layout.astro";
import OurServicesBody from "../components/OurServicesBody.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ModernContactForm from "../components/ModernContactForm.astro";
import { DETAILS } from "../constants/details";
import { BUSINESS_NODE, BUSINESS_REF } from "../constants/business";

// SEO and structured data
const pageTitle =
  "Joinery & Building Services in York | Coulsy Joinery";
const pageDescription =
  "Professional joinery and building services in York and across Yorkshire: joinery and carpentry, building alterations and refurbishment, commercial property maintenance, subcontract joinery and kitchen installation.";
// const canonicalUrl = "https://coulsyjoinery.co.uk/joinery-services"; // Not used

// Structured data for services page
// One self-contained @graph: the canonical business, plus this hub's Service. The provider
// references the business by @id rather than redeclaring it, and the business carries NO
// address and NO geo — see `constants/business.ts`.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    BUSINESS_NODE,
    {
      "@type": "Service",
      "@id": "https://coulsyjoinery.co.uk/joinery-services#service",
      name: "Professional Joinery & Building Services",
      description: pageDescription,
      url: "https://coulsyjoinery.co.uk/joinery-services",
      provider: BUSINESS_REF,
      areaServed: ["York", "Wetherby", "Harrogate", "Leeds", "Yorkshire"].map(
        (name) => ({ "@type": "City", name })
      ),
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Joinery and Building Services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Joinery and Carpentry",
          description:
            "Site joinery and carpentry for refurbishments, alterations and fit-outs",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Building Alterations and Refurbishment",
          description:
            "Alterations and refurbishment inside existing homes and business premises",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Commercial Property Maintenance",
          description:
            "Repairs and maintenance for shops, offices and other business premises",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Subcontract Joinery",
          description:
            "Site joinery for contractors and fit-out firms",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Kitchen Installation",
          description:
            "Kitchens surveyed, specified, sourced and installed",
        },
      },
      // Matches the primary service cards. Garden buildings, bespoke joinery and heritage
      // restoration are deliberately not listed — see MainPage.astro.
        ],
      },
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <script
      is:inline
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>
  <main class="mx-auto relative z-10">
    <section class="w-full container mx-auto px-4 sm:px-6 py-8">
      <div class="pt-8 pb-6">
        <Breadcrumb
          crumbs={[
            {
              href: "/joinery-services",
              label: "Joinery Services",
              current: true,
            },
          ]}
        />
      </div>

      <h1 class="text-3xl font-bold tracking-tight pb-4">
        Professional Joinery & Building Services in York & Yorkshire

      </h1>

      <p class="text-gray-700 text-lg mb-6">
        I'm Robert, a time-served joiner with experience going back to 1988
        offering reliable, high-quality work across York and beyond. From joinery and carpentry to building alterations, refurbishment and commercial maintenance — this page shows the services I can help you with.
      </p>

      <!-- Trust indicators -->
      <div class="flex flex-wrap gap-4 items-center text-sm text-gray-600 mb-8">
        <div class="flex items-center gap-2">
          <svg
            class="w-5 h-5 text-green-500"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span>Joiner Since 1988</span>
        </div>
        <div class="flex items-center gap-2">
          <svg
            class="w-5 h-5 text-green-500"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span>Fully Qualified</span>
        </div>
        <div class="flex items-center gap-2">
          <svg
            class="w-5 h-5 text-green-500"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span>Personal Service</span>
        </div>
      </div>

      <!-- Services Grid Section -->
      <section class="w-full container mx-auto px-4 sm:px-6 py-12">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-brand-900 mb-4">
            A Selection of My Joinery Services
          </h2>
          <p class="text-lg text-brand-600 max-w-3xl mx-auto">
            Here's a selection of the kind of work I take on regularly. Each
            service is personally managed by me, ensuring quality and attention
            to detail throughout.
          </p>
        </div>

        <OurServicesBody variant="all" />

        <div class="text-center mt-12">
          <p class="text-lg text-brand-700 font-semibold mb-4">
            Not sure whether it's work I take on?
          </p>
          <a
            href="/contact"
            class="inline-flex items-center px-6 py-3 bg-brand-600 text-white font-medium rounded-lg hover:bg-brand-700 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2"
          >
            Tell me what's involved
            <svg
              class="w-5 h-5 ml-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </section>

      <!-- Trust & Experience Section -->
      <section class="w-full bg-brand-50 py-12">
        <div class="container mx-auto px-4 sm:px-6">
          <div class="max-w-4xl mx-auto space-y-8">
            <!-- Craftsmanship Card -->
            <div
              class="bg-white rounded-xl shadow-lg p-8 border border-brand-200"
            >
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0">
                  <div
                    class="w-12 h-12 bg-brand-100 rounded-lg flex items-center justify-center"
                  >
                    <svg
                      class="w-6 h-6 text-brand-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                      ></path>
                    </svg>
                  </div>
                </div>
                <div>
                  <h2 class="text-2xl font-semibold text-brand-900 mb-3">
                    Craftsmanship You Can Trust
                  </h2>
                  <p class="text-brand-700 leading-relaxed">
                    Whatever the project, I take pride in delivering proper work that lasts. I treat every job with care and a hands-on approach, using the skills I've built in the trade since 1988.
                  </p>
                </div>
              </div>
            </div>

            <!-- Personal Quote -->
            <div
              class="bg-gradient-to-r from-brand-600 to-brand-700 rounded-xl p-8 text-white"
            >
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0">
                  <div
                    class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center"
                  >
                    <svg
                      class="w-6 h-6 text-white"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z"
                        clip-rule="evenodd"></path>
                    </svg>
                  </div>
                </div>
                <div>
                  <blockquote class="text-lg italic leading-relaxed">
                    "I'm Robert — a time-served joiner with experience going back to 1988. Every job I take on is personally managed by me,
                    from the first chat to the final fitting. Whether it's a
                    custom door, kitchen install, or a full build, I believe in
                    doing things properly, with no shortcuts. I enjoy working
                    with homeowners, landlords, and businesses who appreciate
                    honest, reliable work and clear communication."
                  </blockquote>
                  <div class="mt-4 font-medium">
                    — Robert Coulson, MICWCI
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Contact CTA Section -->
      <section class="w-full container mx-auto px-4 sm:px-6 py-12">
        <div class="max-w-4xl mx-auto">
          <ModernContactForm
            title="Ready to Start Your Project?"
            subtitle="I mainly take on joinery and building projects, commercial maintenance and contract work. Alterations and refurbishment projects of a manageable size are welcome. I don't generally take on isolated small domestic jobs. Tell me what's involved, where it is and when you need it."
          />
        </div>
      </section>
    </section>
  </main>
</Layout>
