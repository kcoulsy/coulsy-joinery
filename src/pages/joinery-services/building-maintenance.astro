---
import Layout from "../../layouts/Layout.astro";
import ModernContactForm from "../../components/ModernContactForm.astro";
import { getFormattedPageData } from "../../utils/pageMeta";
import ReviewsLinkSection from "../../components/ReviewsLinkSection.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import MeetRobertCard from "../../components/MeetRobertCard.astro";
import ServiceFeatureCard from "../../components/ServiceFeatureCard.astro";
import ServiceListCard from "../../components/ServiceListCard.astro";
import NearbyAreas from "../../components/NearbyAreasBuildingMaintenance.astro";

import GalleryGrid from "../../components/GalleryGrid.astro";
import { Image } from "astro:assets";
import complianceImage from "../../assets/images/compliance.jpeg";
import galleryImg1 from "../../assets/images/building-maintenance/building-maintenance-before-after-800x600.jpg";
import galleryImg2 from "../../assets/images/building-maintenance/building-maintenance-floor-before-after-800x600.jpg";
import galleryImg3 from "../../assets/images/heritage/oak-window-restoration.jpg";
import galleryImg4 from "../../assets/images/placeholder-coming-soon-800x600.jpg";
import galleryImg5 from "../../assets/images/placeholder-coming-soon-800x600.jpg";
import galleryImg6 from "../../assets/images/placeholder-coming-soon-800x600.jpg";

interface Props {
  location?: string;
}

const { location: locationProp } = Astro.props;
const location = locationProp || Astro.params.location;

const {
    formattedServiceName,
  displayServiceName,
  locationInText,
  cleanLocationName,
    businessSchema,

  defaultDescription,
  enhancedKeywords,
  enhancedDescription,
  pageTitle,
} = getFormattedPageData(Astro);

// The description comes from SERVICE_DESCRIPTIONS in pageMeta.ts (one source of truth).
const finalDescription = enhancedDescription || defaultDescription;
---

<Layout
  title={`${pageTitle} | Coulsy Joinery`}
  description={finalDescription}
  keywords={enhancedKeywords}
  structuredData={businessSchema}
>
    {/* No FAQ JSON-LD on this page. The shared FAQ pool in pageMeta.ts is written for domestic
      joinery (kitchens, housing stock) and none of it is visible on the page, so emitting it
      here would publish answers this service does not give. */}

  <main class="mx-auto relative z-10">
    <ServiceHero
      quoteFor={`commercial property maintenance${locationInText}`.trim()}
      badge="Commercial Property Maintenance"
      title={pageTitle}
      description="Repairs and maintenance for shops, offices and other commercial premises. One reliable point of contact, work done properly, and a tradesperson who gets to know your building."
      breadcrumbCrumbs={[
        { label: "Joinery Services", href: "/joinery-services" },
        ...(cleanLocationName
          ? [
              {
                                label: displayServiceName,
                href: `/joinery-services/${formattedServiceName.toLowerCase().replace(/\s+/g, "-")}`,
              },
              { label: cleanLocationName, current: true },
            ]
          : [{ label: displayServiceName, current: true }]),
      ]}
    />

    <!-- Main Content Section -->
    <section class="section bg-white">
      <div class="container-wide">
        <div class="grid lg:grid-cols-2 items-start gap-12 lg:gap-20">
          <!-- Content Column -->
          <div class="order-2 lg:order-1 animate-on-scroll">
            <div
              class="space-y-6 text-neutral-700 leading-relaxed text-balance"
            >
              <MeetRobertCard
                introText={`I carry out repairs and maintenance for commercial premises${locationInText} — shops, offices and managed buildings. I'm Robert — a time-served joiner and builder, in the trade since 1988. You deal with the same person each time, who gets to know your building.`}
              />

              <div class="space-y-4">
                <p>
                  Whether it's a list of repairs across a premises, planned maintenance through the year, or a single job that needs doing properly, you deal directly with me. Smaller jobs are welcome from business customers — commercial maintenance is about looking after the same premises over time.
                </p>
                <p>
                  This service is for retailers, office occupiers, landlords, managing agents and property management companies{locationInText}. Facilities management companies that need a reliable local joiner and builder to carry out work on site are welcome to get in touch.
                </p>
                <p>
                  Urgent repairs for commercial customers can be undertaken subject to availability.
                </p>
              </div>

              <!-- Services Section -->
              <div class="card card-hover border-l-4 border-accent-500">
                <div class="card-body">
                  <h3 class="text-lg font-semibold text-neutral-900 mb-2">
                    Commercial Property Maintenance{locationInText}
                  </h3>
                  <ul class="space-y-2 text-neutral-600">
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-accent-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      Planned maintenance visits and schedules

                    </li>
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-accent-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      Urgent repairs, subject to availability

                    </li>
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-accent-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      Commercial door and window repairs and maintenance

                    </li>
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-accent-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      Repairs to floors, ceilings, partitions and building fabric

                    </li>
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-accent-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      Roof and gutter maintenance

                    </li>
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-accent-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      Fit-out repairs and alterations for shops and offices

                    </li>
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-accent-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      Coordination of other trades where a job needs them

                    </li>
                  </ul>
                </div>
              </div>

              <!-- Landlord & Estate Agent Services Section -->
              <div class="card card-hover border-l-4 border-brand-500 bg-gradient-to-r from-brand-50 to-white">
                <div class="card-body">
                  <h3 class="text-lg font-semibold text-neutral-900 mb-2">
                    Landlords, Managing Agents and Property Managers{locationInText}
                  </h3>
                  <p class="text-neutral-600 mb-4">
                    I provide reliable maintenance for landlords, managing agents and property management companies{locationInText}. Whether you manage one unit or a portfolio, you get clear communication, quality workmanship and properties kept in good order.
                  </p>
                  <ul class="space-y-2 text-neutral-600">
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-brand-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      Urgent repairs, subject to availability

                    </li>
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-brand-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      Repairs and making good between tenancies

                    </li>
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-brand-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      Routine maintenance for let properties

                    </li>
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-brand-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      HMO repairs and maintenance

                    </li>
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-brand-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      Maintenance across a managed portfolio

                    </li>
                    <li class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-brand-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      Contractor support for managing agents

                    </li>
                  </ul>
                </div>
              </div>

              <div class="space-y-6">
                <div class="card card-hover border-l-4 border-accent-500">
                  <div class="card-body">
                    <h3 class="text-lg font-semibold text-neutral-900 mb-2">
                      Other Trades When a Job Needs Them
                    </h3>
                    <p class="text-neutral-600">
                      Where a job needs more than joinery and building work, I bring in tradespeople I know and trust — plasterers, tilers, electricians, plumbers and roofers — and coordinate the work, so you have one point of contact.
                    </p>
                    <p class="text-neutral-600 mt-2">
                      I'm a <a
                        href="/about/qualifications"
                        class="font-semibold text-brand-600 hover:text-brand-700 transition-colors"
                        >City & Guilds Advanced Craft carpenter and joiner</a
                      >, in the trade since 1988.
                    </p>
                  </div>
                </div>

                <div class="card card-hover border-l-4 border-accent-500">
                  <div class="card-body">
                    <h3 class="text-lg font-semibold text-neutral-900 mb-2">
                      Quality-Driven Maintenance
                    </h3>
                    <p class="text-neutral-600">
                      I prioritise quality, attention to detail and repairs that last. My City & Guilds qualifications and time in the trade since 1988 stand behind every maintenance job.
                    </p>
                  </div>
                </div>

                <div class="card card-hover border-l-4 border-accent-500">
                  <div class="card-body">
                    <h3 class="text-lg font-semibold text-neutral-900 mb-2">
                      For Facilities Management Companies
                    </h3>
                    <p class="text-neutral-600">
                      If you manage premises for clients and need joinery, building repairs and small works carried out on site, I can work as your contractor. I don't provide facilities management myself — I carry out the work, to your instruction, with RAMS provided where required.
                    </p>
                  </div>
                </div>

              </div>

              <!-- Why Choose Me Section -->
              <div
                class="card card-hover border-l-4 border-accent-500 bg-gradient-to-r from-accent-50 to-white"
              >
                <div class="card-body">
                  <h2
                    class="text-2xl font-bold text-neutral-900 mb-4 flex items-center gap-3"
                  >
                    <svg
                      class="w-6 h-6 text-accent-600"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"></path>
                    </svg>
                    Why Choose Me?
                  </h2>
                  <div class="space-y-4">
                    <p class="text-neutral-600">
                      Need a reliable contractor for your premises? I'm happy to look at the building, discuss what's needed and give you a clear, professional quote. I understand that maintenance problems disrupt a business, so I aim to get the work done efficiently and with as little disruption as I can.
                    </p>
                    {
                      cleanLocationName && (
                        <p class="text-neutral-600">
                          {cleanLocationName} includes a wide variety of commercial properties — from modern offices and retail units to older and period commercial buildings. I have maintained commercial buildings of different ages and types.
                        </p>
                      )
                    }
                  </div>
                </div>
              </div>

              <ReviewsLinkSection />
            </div>
          </div>

          <!-- Sidebar Column -->
          <div class="order-1 lg:order-2 animate-on-scroll">
            <div class="space-y-8">
              <!-- Gallery Section -->
              <div class="card card-hover overflow-hidden">
                <div class="card-header">
                  <h2 class="text-xl font-bold text-neutral-900">
                    Commercial Maintenance Work
                  </h2>
                  <p class="text-neutral-600 mt-2">
                    Examples of repairs and maintenance from previous projects
                  </p>
                </div>
                <div class="card-body p-0">
                  <GalleryGrid
                    items={[
                      {
                        src: galleryImg1,
                        label: "Building Maintenance Before & After",
                        alt: `Commercial building maintenance repair work showing before and after transformation${cleanLocationName ? ` ${cleanLocationName}` : ""}`,
                      },
                      {
                        src: galleryImg2,
                        label: "Commercial Floor Repair Before & After",
                        alt: `Commercial floor repair and restoration work for building maintenance${cleanLocationName ? ` ${cleanLocationName}` : ""}`,
                      },
                      {
                        src: galleryImg3,
                        label: "Heritage Window Maintenance",
                        alt: `Heritage window restoration and commercial building maintenance work${cleanLocationName ? ` ${cleanLocationName}` : ""}`,
                      },
                      {
                        src: galleryImg4,
                        label: "Commercial Door Maintenance",
                        alt: `Commercial door repair and maintenance services${cleanLocationName ? ` ${cleanLocationName}` : ""}`,
                        loading: "lazy",
                      },
                      {
                        src: galleryImg5,
                        label: "Roof & Gutter Maintenance",
                        alt: `Roof and gutter maintenance${cleanLocationName ? ` ${cleanLocationName}` : ""}`,
                        loading: "lazy",
                      },
                      {
                        src: galleryImg6,
                        label: "Previous Work",
                        alt: `Photograph of previous work`,
                        loading: "lazy",
                      },
                    ]}
                  />
                </div>
              </div>

              <!-- Contact Form Section -->
              <div class="card card-hover gradient-brand text-white">
                <div class="card-body">
                  <div class="text-center mb-6">
                    <div
                      class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4"
                    >
                      <svg
                        class="w-8 h-8 text-white"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                        ></path>
                        <path
                          d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                        ></path>
                      </svg>
                    </div>
                    <h2 class="text-2xl font-bold mb-2">
                      Get in Touch About Your Premises
                    </h2>
                    <p class="text-brand-100">
                      Need repairs or ongoing maintenance for commercial premises? Tell me about the building and what's needed.
                    </p>
                  </div>
                  <ModernContactForm
                    title="Discuss Your Requirements"
                    subtitle="Tell me about the premises, what's needed and how soon."
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Nearby Areas Section -->
    <section class="section bg-neutral-50">
      <div class="container-wide">
        <div class="animate-on-scroll">
          <NearbyAreas location={location} />
        </div>
      </div>
    </section>
  </main>
</Layout>

