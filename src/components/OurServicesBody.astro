---
import { Image } from "astro:assets";
import studWall from "../assets/images/stud-wall-new-build.jpeg";
import mouldingPlane from "../assets/images/moulding_plane.png";

import kitchenInstallers from "../assets/images/Kitchen-Installers.jpg";
import SubcontractImg from "../assets/images/sub-contract.jpg";
import rooftop from "../assets/images/rooftop.jpg";
import cutRoofHeader from "../assets/images/cut-roofs/cut-roof-header.jpg";
import trussRoofImage from "../assets/images/truss-roofs/attic-trusses.jpg";
import complianceImage from "../assets/images/compliance.jpeg";

import steelFireExit from "../assets/images/steel-exit-doors/Security-Fire-Exit-Door-510x510.jpg";
import generalJoinery from "../assets/images/general-joinery/fencing-and-gates.jpg";
import smallBuildImage from "../assets/images/small-build-services/small-building-works-glazed-office-800x600.jpg";
import buildingMaintenanceImage from "../assets/images/building-maintenance/building-maintenance-before-after-800x600.jpg";
import heritage from "../assets/images/heritage/oak-window-restoration.jpg";
import fireDoor from "../assets/images/doors/fire-doors1.jpg";

interface Props {
  /**
   * "primary"  — the homepage. Shows only work Robert actively wants to sell.
   * "all"      — the /joinery-services hub. Also shows secondary services that
   *              stay indexed and reachable but are not promoted.
   * See ARCHITECTURE.md §1 (navigation philosophy) and §3 (secondary services).
   */
  variant?: "primary" | "all";
}

const { variant = "primary" } = Astro.props;

// PRIMARY services: shown on the homepage and on the /joinery-services hub. These are the
// services the business wants to be found and chosen for. Owner decision, 19 Nov 2026.
const services = [
  {
    title: "Joinery & Carpentry",
    href: "/joinery-services/general-joinery",
    image: generalJoinery,
    alt: "Joinery and carpentry in York",
    description: "Site joinery and carpentry for refurbishments, alterations and fit-outs — first fix through to finishing.",
    category: "Joinery",
  },
  {
    title: "Building Alterations & Refurbishment",
    href: "/joinery-services/small-build-services",
    image: smallBuildImage,
    alt: "Building alterations and refurbishment in York",
    description: "Alterations and refurbishment inside existing homes and business premises — layouts changed, openings formed, rooms refitted.",
    category: "Building",
  },
  {
    title: "Commercial Property Maintenance",
    href: "/joinery-services/building-maintenance",
    image: buildingMaintenanceImage,
    alt: "Commercial property maintenance in York",
    description: "Repairs and maintenance for shops, offices and other business premises. Repeat and ongoing work welcome.",
    category: "Commercial",
  },
  {
    title: "Subcontract Joinery",
    href: "/joinery-services/joinery-subcontractors",
    image: SubcontractImg,
    alt: "Subcontract joinery",
    description: "Site joinery for contractors and fit-out firms, labour-only or supply-and-fix, including longer contracts.",
    category: "Commercial",
  },
  {
    title: "Stud Partitions",
    href: "/joinery-services/stud-wall-partitioning",
    image: studWall,
    alt: "Stud partitions in York",
    description: "Timber stud partitions and internal alterations for homes and commercial fit-outs.",
    category: "Construction",
  },
  {
    title: "Kitchen Installation",
    href: "/joinery-services/kitchen-installers",
    image: kitchenInstallers,
    alt: "Kitchen installation in York",
    description: "Kitchens surveyed, specified, sourced and installed.",
    category: "Kitchens",
  },
];

// SECONDARY services: kept live, indexed and reachable from the /joinery-services hub, but not
// promoted on the homepage or in the navigation. Owner decision, 19 Nov 2026 — no URL is retired
// by this. See ARCHITECTURE.md §1 and §3.
//
// DO NOT remove an entry from this list without giving its pages another way in. The hub link
// here is each family's only route from the rest of the site: Door Hanging was once absent from
// both this catalogue and the navbar, and its hub and all 56 town pages became unreachable. It
// also carries the fire-door hand-off to Coulsy Fire Doors (see `CommonFaults.astro`).
const secondaryServices = [
  {
    title: "Fitted & Architectural Joinery",
    href: "/joinery-services/bespoke-joinery",
    image: mouldingPlane,
    alt: "Fitted and architectural joinery",
    description: "Fitted and architectural joinery — specified, sourced from specialist manufacturers and installed.",
    category: "Joinery",
  },
  {
    title: "Doors and Frames",
    href: "/joinery-services/door-hanging",
    image: fireDoor,
    alt: "Door and fire door installation in York",
    description:
      "Door sets, frames and fire doors fitted as part of refurbishment, joinery and commercial maintenance work.",
    category: "Joinery",
  },
  {
    title: "Steel Fire Exit Doors",
    href: "/joinery-services/steel-fire-exit-doors-installers",
    image: steelFireExit,
    alt: "Steel fire exit and fire escape doors",
    description: "Robust, compliant fire exit doors for commercial spaces.",
    category: "Commercial",
  },
  {
    title: "Traditional Cut Roofs",
    href: "/joinery-services/traditional-cut-roofs",
    image: cutRoofHeader,
    alt: "Traditional cut roofs and timber roof framing in York",
    description: "Traditional hand-cut roof construction designed and built to suit any shape or layout.",
    category: "Roofing",
  },
  {
    title: "Truss Roof Installers",
    href: "/joinery-services/truss-roof-installers",
    image: trussRoofImage,
    alt: "Truss roof installation and structural joinery in York",
    description: "Truss roof installation for domestic and commercial builds.",
    category: "Roofing",
  },
  {
    title: "Period Property Joinery",
    href: "/joinery-services/heritage-restoration-joinery",
    image: heritage,
    alt: "Sash window and period timber repairs",
    description: "Joinery and refurbishment for period properties, drawing on heritage construction experience.",
    category: "Heritage",
  },
];

const visibleServices =
  variant === "all" ? [...services, ...secondaryServices] : services;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-7xl mx-auto">
  {
    visibleServices.map((service, index) => (
      <a
        href={service.href}
        class="group relative bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 ease-in-out hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2"
        aria-label={`Learn more about ${service.title} services`}
      >
        <!-- Image Container -->
        <div class="relative overflow-hidden rounded-t-xl">
          <Image
            src={service.image}
            alt={service.alt}
            loading={index < 4 ? "eager" : "lazy"}
            priority={index < 4}
            width={400}
            height={300}
            decoding="async"
            format="webp"
            quality={80}
            class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <!-- Overlay on hover -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          
          <!-- Service badge -->
          <div class="absolute top-3 left-3">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-brand-100 text-brand-800">
              {service.title}
            </span>
          </div>
        </div>

        <!-- Content -->
        <div class="p-6">
          <h3 class="text-lg font-semibold text-brand-900 mb-2 group-hover:text-brand-600 transition-colors duration-200">
            {service.title}
          </h3>
          <p class="text-sm text-brand-600 leading-relaxed">
            {service.description}
          </p>
          
          <!-- CTA Arrow -->
          <div class="mt-4 flex items-center text-brand-500 group-hover:text-brand-600 transition-colors duration-200">
            <span class="text-sm font-medium">Learn more</span>
            <svg 
              class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform duration-200" 
              fill="none" 
              stroke="currentColor" 
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </div>

        <!-- Hover effect border -->
        <div class="absolute inset-0 rounded-xl border-2 border-transparent group-hover:border-brand-200 transition-colors duration-300 pointer-events-none"></div>
      </a>
    ))
  }
</div>
