---
// This is the main index page

import Layout from "../layouts/Layout.astro";
import HeroSlider from "../components/HeroSlider.astro";
import Why from "../components/Why.astro";
import OurServicesBody from "../components/OurServicesBody.astro";
import Reviews from "../components/Reviews.astro";
import ProminentPhoneButton from "../components/ProminentPhoneButton.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { DETAILS } from "../constants/details";
import { BUSINESS_NODE } from "../constants/business";

// Import images with modern priority loading
import timber20joinery from "../assets/images/timber20joinery.jpg";
import mouldingPlane from "../assets/images/moulding_plane.png";
import kitchenFitter from "../assets/images/kitchens/kitchen-fitter-domestic.jpg";

const slides = [
  {
    image: mouldingPlane,
    text: "Professional Joinery & Building Services",
    subtitle: "Building alterations, refurbishment, commercial maintenance and subcontract joinery.",
    cta: {
      text: "Discuss Your Project",
      link: "/contact",
    },
  },
  {
    image: timber20joinery,
    text: "Independent, time-served joiner and builder, in the trade since 1988.",
    subtitle: "York, Wetherby, Harrogate, Leeds and surrounding areas.",
    cta: {
      text: "Discuss Your Project",
      link: "/contact",
    },
  },
  {
    image: kitchenFitter,
    text: "Kitchen Installation and Fitted Joinery",
    subtitle: "Surveyed, specified, sourced and installed by the same joiner.",
    cta: {
      text: "Services",
      link: "/joinery-services",
    },
  },
];

// Enhanced SEO optimization with personal voice preserved
const seoData = {
  title:
    "Joiner & Builder in York – Joinery & Refurbishment | Coulsy Joinery",
  // "heritage restoration" / "heritage joinery" removed from the homepage description and
  // keywords (5 Nov 2026) — the homepage does not display heritage work at all (it was
  // already demoted from the nav and homepage cards), so promoting it in the one meta
  // surface every visitor's search result is built from was a mismatch between promotion
  // and actual page content. This is a narrow, homepage-only fix, NOT the bounded heritage
  // signals audit ARCHITECTURE.md §10a calls for (pageMeta.ts's 1,027 geo keyword refs and
  // 359 FAQ schema instances across the geo pages) — that remains deliberately deferred and
  // not yet authorised. Do not extend this fix into pageMeta.ts on the strength of this
  // comment.
  description:
    "Family-run joinery and building business in York, in the trade since 1988: building alterations, refurbishment, commercial maintenance and subcontract joinery.",
  keywords:
    "joiner York, builder York, joinery, building alterations, refurbishment, commercial property maintenance, subcontract joinery, kitchen installation",
  ogImage: "/og-image.jpg",
  canonical: "https://coulsyjoinery.co.uk",
  structuredData: {
    "@context": "https://schema.org",
    // The SAME canonical business entity used on every other page — same @id, same
    // properties. See `constants/business.ts`.
    //
    // NO address, NO geo, NO serviceArea/GeoCircle. The registered office is Robert's home
    // and Coulsy is a service-area business; the office is published once, as a legal
    // disclosure, on /company-information. The previous block also claimed coordinates
    // 0.11 miles from York city centre — ~9.5 miles from the address printed beside them.
    ...BUSINESS_NODE,
    description:
      "Professional joinery and building services in York: joinery and carpentry, building alterations and refurbishment, commercial property maintenance, subcontract joinery and kitchen installation.",
    areaServed: ["York", "Wetherby", "Harrogate", "Leeds", "Yorkshire"],
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Joinery and Building Services",
      itemListElement: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Joinery and Carpentry",
            description:
              "Site joinery and carpentry for refurbishments, alterations and fit-outs",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Building Alterations and Refurbishment",
            description:
              "Alterations and refurbishment inside existing homes and business premises",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Commercial Property Maintenance",
            description:
              "Repairs and maintenance for shops, offices and other business premises",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Subcontract Joinery",
            description:
              "Site joinery for contractors and fit-out firms",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Kitchen Installation",
            description:
              "Kitchens surveyed, specified, sourced and installed",
          },
        },
        // Garden buildings, bespoke joinery and heritage restoration are deliberately not listed:
        // they are not services the business advertises. Owner decision, 19 Nov 2026.
      ],
    },
    foundingDate: "1989",
    founder: {
      "@type": "Person",
      name: "Robert Coulson",
      honorificSuffix: "MICWCI",
      jobTitle: "Joiner, Builder and Fire Door Specialist",
      description:
        "City & Guilds qualified in 1989 with joinery experience going back to 1988",
    },
    employee: [
      {
        "@type": "Person",
        name: "Robert Coulson",
        honorificSuffix: "MICWCI",
        jobTitle: "Joiner, Builder and Fire Door Specialist",
        description: "City & Guilds qualified in 1989 with experience going back to 1988",
      },
      {
        "@type": "Person",
        name: "Debbie Coulson",
        jobTitle: "Project Manager",
      },
    ],
    // NO aggregateRating, and no Review nodes. This is deliberate — do not add them.
    //
    // The reviews are Google reviews of us, and this schema describes us. Ratings a
    // business publishes about itself are "self-serving": since 2019 Google has not
    // shown review rich results for self-serving LocalBusiness/Organization markup,
    // so this could never have earned a star snippet. It was ineligible, not merely
    // inaccurate — and it had drifted anyway, claiming 10 reviews while 12 were on
    // the page.
    //
    // Removing it costs nothing. The stars Coulsy actually shows in Maps and the
    // local pack come from the Google Business Profile, which this markup does not
    // feed. The twelve reviews remain visible on the page for human readers.
    //
    // `cc5e794` already stripped aggregateRating from 1,027 service pages for the
    // adjacent rule (the rated reviews must be present on the page). It missed this
    // one. This completes it.
    award: [
      "City & Guilds Qualified (1989)",
      "CSCS Gold Card Holder",
      "£5m Public and Products Liability Insurance",
      "VAT Registered",
    ],
    brand: {
      "@type": "Brand",
      name: "Coulsy Joinery",
      slogan: "Professional Joinery & Building Services",
    },
  },
};
---

<Layout
  title={seoData.title}
  description={seoData.description}
  keywords={seoData.keywords}
  ogImage={seoData.ogImage}
  structuredData={seoData.structuredData}
  classes=""
>
  <!-- Hero Section with modern optimization -->
  <section class="relative z-10 mx-auto animate-on-scroll">
    <HeroSlider slides={slides} />
  </section>

  <!--
    Primary call-to-action. The hero fills the first mobile screen and the only
    other phone links on this page are in the collapsed menu and the footer, so
    without this the homepage gives a mobile visitor no way to ring Robert.
    Static markup only — no JS, no images, so it cannot shift layout.
  -->
  <section
    class="relative z-10 bg-brand-50 border-y border-brand-100"
    aria-labelledby="call-cta-heading"
  >
    <div
      class="container mx-auto px-4 py-8 flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-between sm:text-left"
    >
      <div>
        <h2 id="call-cta-heading" class="text-xl font-semibold text-brand-900">
          Got a project, or premises that need looking after? Talk to Robert directly.
        </h2>
        <p class="mt-1 text-brand-600">
          No sales team, no call centre — you speak to the person doing the work.
        </p>
      </div>
      <div class="flex-shrink-0">
        <ProminentPhoneButton note={null} />
        <WhatsAppButton />
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section with personal voice preserved -->
  <section class="relative z-10 mx-auto animate-on-scroll">
    <Why />
  </section>

  <!-- Services Section with modern structure -->
  <section
    class="section bg-gradient-to-b from-white to-brand-50 relative z-10"
  >
    <div class="container-wide">
      <div class="section-header animate-on-scroll">
        <h2 class="section-title text-gradient">Services</h2>
        <p class="section-subtitle text-balance">
          Joinery and carpentry, building alterations and refurbishment, commercial property maintenance, subcontract joinery and kitchen installation.
        </p>
      </div>

      <div class="animate-on-scroll">
        <OurServicesBody />
      </div>
    </div>
  </section>

  <!-- Call to Action Section with enhanced styling -->
  <section class="section gradient-brand relative z-10 overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute top-0 left-0 w-64 h-64 bg-white rounded-full -translate-x-32 -translate-y-32"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-96 h-96 bg-white rounded-full translate-x-48 translate-y-48"
      >
      </div>
    </div>

    <div class="container-narrow relative">
      <div class="text-center animate-on-scroll">
        <h2
          class="text-3xl lg:text-4xl xl:text-5xl font-bold text-white mb-6 text-balance"
        >
          Ready to Talk It Through?
        </h2>
        <p class="text-xl text-brand-100 mb-8 max-w-2xl mx-auto text-balance">
          Whether it's a refurbishment, an alteration to your premises, a kitchen installation or joinery on a contract, tell me what's involved and I'll tell you straight whether it's one for me.
        </p>
        <div
          class="flex flex-col sm:flex-row gap-4 justify-center items-center"
        >
          <a
            href="/contact"
            class="btn btn-secondary btn-lg hover-lift focus-ring"
            aria-label="Discuss your project with Coulsy Joinery"
          >
            Discuss Your Project
          </a>
          <a
            href="/joinery-services"
            class="btn btn-outline btn-lg hover-lift focus-ring border-white text-white hover:bg-white hover:text-brand-900"
            aria-label="View all services"
          >
            View All Services
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section with clean presentation -->
  <section class="section relative z-10 bg-neutral-50">
    <div class="container-wide">
      {/* The Reviews component carries its own heading; a second one here duplicated it. */}
      

      <div class="animate-on-scroll">
        <Reviews />
      </div>
    </div>
  </section>
</Layout>

<!-- Note: Structured data is already included in Layout component, no need to duplicate -->
